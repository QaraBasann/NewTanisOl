# ==============================================================
# Tanış Ol v2.0 — Render Environment Variables (.env.example)
# Qeyd: Bu fayl yalnız mühit dəyişənlərinin adlarını təqdim edir.
# Heç bir gizli açar bu faylda və ya koda yazılmamalıdır!
# ==============================================================

# Gemini AI Konfiqurasiyası
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_MAX_OUTPUT_TOKENS=1500
GEMINI_DAILY_REQUEST_LIMIT=100
ENABLE_EMBEDDING_CHECK=false
SIMILARITY_THRESHOLD=0.55

# Server və Verilənlər Bazası
PORT=3000
NODE_ENV=production
SQLITE_PATH=tanisol.db
DATABASE_URL=
SESSION_SECRET=your_random_secret_here
CORS_ORIGIN=*
DATA_RETENTION_DAYS=30
